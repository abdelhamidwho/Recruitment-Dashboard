datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Attribution relations (SearchRun.owner, Job.createdBy, WatchlistItem.addedBy,
// StageEvent.user, JobCandidate.owner, JobCandidate.updatedBy, Note.author,
// SavedSearch.owner) deliberately omit onDelete, so Prisma restricts the delete
// by default. This app deactivates users via User.isActive and never deletes
// them, so a restricted delete is the correct behavior: deleting a user must
// never cascade away the organisation's search, job or note history. Do not
// add onDelete: Cascade (or SetNull — full user deletion is not supported) to
// any of these edges.
//
// Ownership nullability follows a rule, not an oversight: SearchRun.ownerId,
// Note.authorId and SavedSearch.ownerId are optional because the migration
// carries pre-authentication rows that have no owner. Job.createdById,
// Watchlist.ownerId and WatchlistItem.addedById are required because those are
// new Phase 1 concepts that can only ever be created by an authenticated action.
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String
  role               String   @default("RECRUITER") // ADMIN, RECRUITER
  mustChangePassword Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions             Session[]
  searchRuns           SearchRun[]
  savedSearches        SavedSearch[]
  profileViews         ProfileView[]
  watchlists           Watchlist[]
  watchlistItemsAdded  WatchlistItem[]
  favorites            Favorite[]
  notes                Note[]
  jobsCreated          Job[]
  jobCandidatesOwned   JobCandidate[]  @relation("JobCandidateOwner")
  jobCandidatesUpdated JobCandidate[]  @relation("JobCandidateUpdatedBy")
  stageEvents          StageEvent[]
}

model Session {
  id        String   @id // sha256 of the cookie token, never the token itself
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt]) // cleanup deletes expired sessions in bulk
}

model Person {
  id             String  @id @default(cuid())
  profileUrl     String  @unique // the deduplication key
  externalId     String?
  // Which source produced this record (e.g. "apify", "github"). Nullable so the
  // pre-existing rows (all Apify/mock, created before this column existed) are
  // left as "unknown source" rather than defaulted to a value that would be a
  // guess; every row written going forward should set this explicitly. Also
  // lets a later phase interpret profileUrl correctly (a GitHub profileUrl is
  // not a LinkedIn one).
  source         String?
  fullName       String
  headline       String?
  currentTitle   String?
  currentCompany String?
  avatarUrl      String?
  summary        String?

  locationRaw String?
  city        String?
  country     String?
  region      String?

  industry             String?
  highestDegree        String?
  fieldsOfStudy        String  @default("[]")
  totalYearsExperience Float?
  workAuthorization    String? // entered by HR, never inferred

  skills         String @default("[]")
  experience     String @default("[]")
  education      String @default("[]")
  languages      String @default("[]")
  certifications String @default("[]")
  raw            String @default("{}")

  firstSeenAt     DateTime @default(now())
  lastRefreshedAt DateTime @default(now())

  searchAppearances SearchRunPerson[]
  profileViews      ProfileView[]
  jobCandidates     JobCandidate[]
  watchlistItems    WatchlistItem[]
  favorites         Favorite[]
  notes             Note[]

  @@index([country])
  @@index([region])
  @@index([industry])
  @@index([highestDegree])
}

model SearchRun {
  id            String   @id @default(cuid())
  name          String?
  // Which source this run used (e.g. "apify", "github"). Nullable for the same
  // reason as Person.source: pre-existing runs predate the adapter layer and
  // were all Apify/mock, but defaulting them to "apify" here would be
  // asserting something this migration cannot actually verify row-by-row.
  source        String?
  runId         String? // Apify run id; not unique, mock mode reuses one value
  datasetId     String?
  status        String   @default("RUNNING") // READY, RUNNING, SUCCEEDED, FAILED, TIMED-OUT, ABORTED
  failureReason String?
  filters       String
  itemCount     Int      @default(0)
  ownerId       String?
  owner         User?    @relation(fields: [ownerId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  people SearchRunPerson[]

  @@index([ownerId, createdAt]) // search history: WHERE ownerId = ? ORDER BY createdAt DESC
  @@index([createdAt]) // unfiltered listing across all owners
}

model SearchRunPerson {
  id             String    @id @default(cuid())
  searchRunId    String
  searchRun      SearchRun @relation(fields: [searchRunId], references: [id], onDelete: Cascade)
  personId       String
  person         Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  score          Int?
  scoreBreakdown String? // null means "not computed"; contrast Person.raw, whose default "{}" means "computed, nothing in it" — callers JSON.parse defaulted columns without a null check
  wasKnownBefore Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@unique([searchRunId, personId])
  @@index([personId])
}

model Job {
  id          String   @id @default(cuid())
  title       String
  location    String?
  description String?
  isArchived  Boolean  @default(false)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidates JobCandidate[]

  @@index([createdById])
}

model JobCandidate {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  stage       String   @default("Sourced") // Sourced, Contacted, Screening, Interview, Offer, Hired, Rejected
  ownerId     String?
  owner       User?    @relation("JobCandidateOwner", fields: [ownerId], references: [id])
  updatedById String?
  updatedBy   User?    @relation("JobCandidateUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events StageEvent[]

  @@unique([jobId, personId])
  @@index([personId])
  @@index([jobId, stage]) // pipeline board: WHERE jobId = ? GROUP BY stage
}

model StageEvent {
  id             String       @id @default(cuid())
  jobCandidateId String
  jobCandidate   JobCandidate @relation(fields: [jobCandidateId], references: [id], onDelete: Cascade)
  fromStage      String?
  toStage        String
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([jobCandidateId])
}

model ProfileView {
  id            String   @id @default(cuid())
  personId      String
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewCount     Int      @default(1)
  firstViewedAt DateTime @default(now())
  lastViewedAt  DateTime @default(now())

  @@unique([personId, userId])
  @@index([userId])
}

model Watchlist {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items WatchlistItem[]

  @@index([ownerId])
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  addedById   String
  addedBy     User      @relation(fields: [addedById], references: [id])
  addedAt     DateTime  @default(now())

  @@unique([watchlistId, personId])
  @@index([personId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, personId])
  @@index([personId])
}

model Note {
  id        String   @id @default(cuid())
  content   String
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  name      String
  filters   String
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}
